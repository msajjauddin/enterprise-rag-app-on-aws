# RAG Application UI configuration
# Values come from `terraform output` (CI also publishes them as the ui-env-vars artifact)

# Query API (CloudFront URL)
API_ENDPOINT=https://dxxxxxxxxxxxx.cloudfront.net

# Cognito hosted UI (single sign-on with the corporate IdP)
AWS_REGION=us-east-1
COGNITO_CLIENT_ID=your_cognito_app_client_id
COGNITO_DOMAIN=your_cognito_domain_prefix

# Must be listed in ui_callback_urls in environments/<env>/terraform.tfvars
REDIRECT_URI=http://localhost:8501/
